# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-app.vercel.app/webhook
TELEGRAM_OWNER_ID=123456789

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram_bot

# Gemini API Keys (Multiple)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=your_gemini_key_3
GEMINI_API_KEY_4=your_gemini_key_4
GEMINI_API_KEY_5=your_gemini_key_5

# Redis (Optional for cache)
REDIS_URL=redis://localhost:6379

# Bot Settings
BOT_NAME=YukiModBot
MAX_MESSAGE_LENGTH=4000
APPEAL_LIMIT=3
LOG_CHAT_ID=-1001234567890
